[Unit]
Description=Consume training sample manifests into xrtm Dataset
After=network-online.target sample-sync.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dlami/nvme/chenxinyu/project/Universal-Edit-Forcing
ExecStart=/usr/bin/python3 tools/sample_sync_writer.py --config configs/sample_sync.yaml
Restart=always
RestartSec=10
TimeoutStopSec=30
StateDirectory=xrtm-sample-sync
RuntimeDirectory=xrtm-sample-sync
Environment=PYTHONUNBUFFERED=1
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
